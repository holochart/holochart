{
  "name": "@mk7s/holochart",
  "version": "0.1.0-alpha.0",
  "description": "Holochart: declarative, GPU-rendered charts built on three.js (full bundle).",
  "keywords": [
    "charts",
    "plotly",
    "webgl",
    "three",
    "data-visualization",
    "gpu",
    "3d",
    "financial",
    "scientific",
    "plotting"
  ],
  "license": "MIT",
  "author": "sanjee",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/geo.ts",
    "./src/graph.ts",
    "./src/bundle-2d.ts",
    "./src/iife.ts",
    "./src/iife-3d.ts",
    "./dist/index.js",
    "./dist/geo.js",
    "./dist/graph.js",
    "./dist/holochart.iife.min.js",
    "./dist/holochart-3d.iife.min.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holochart/holochart.git",
    "directory": "packages/holochart"
  },
  "homepage": "https://mk7s.dev/holochart",
  "bugs": {
    "url": "https://github.com/holochart/holochart/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./geo": {
      "source": "./src/geo.ts",
      "types": "./dist/geo.d.ts",
      "import": "./dist/geo.js",
      "default": "./dist/geo.js"
    },
    "./graph": {
      "source": "./src/graph.ts",
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js",
      "default": "./dist/graph.js"
    },
    "./holochart.iife.min.js": "./dist/holochart.iife.min.js",
    "./holochart-3d.iife.min.js": "./dist/holochart-3d.iife.min.js",
    "./fonts/*": "./dist/fonts/*",
    "./global": {
      "types": "./global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/holochart.iife.min.js",
  "jsdelivr": "dist/holochart.iife.min.js",
  "files": [
    "dist",
    "global.d.ts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mk7s/holochart-components": "workspace:*",
    "@mk7s/holochart-core": "workspace:*",
    "@mk7s/holochart-express": "workspace:*",
    "@mk7s/holochart-render": "workspace:*",
    "@mk7s/holochart-runtime": "workspace:*",
    "@mk7s/holochart-themes": "workspace:*",
    "@mk7s/holochart-traces-3d": "workspace:*",
    "@mk7s/holochart-traces-basic": "workspace:*",
    "@mk7s/holochart-traces-finance": "workspace:*",
    "@mk7s/holochart-traces-geo": "workspace:*",
    "@mk7s/holochart-traces-graph": "workspace:*",
    "@mk7s/holochart-traces-hier": "workspace:*",
    "@mk7s/holochart-traces-sci": "workspace:*",
    "@mk7s/holochart-traces-stats": "workspace:*"
  },
  "peerDependencies": {
    "three": ">=0.180.0 <0.187.0",
    "@types/three": ">=0.180.0 <0.187.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "catalog:",
    "@types/three": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./geo": {
        "types": "./dist/geo.d.ts",
        "import": "./dist/geo.js",
        "default": "./dist/geo.js"
      },
      "./graph": {
        "types": "./dist/graph.d.ts",
        "import": "./dist/graph.js",
        "default": "./dist/graph.js"
      },
      "./holochart.iife.min.js": "./dist/holochart.iife.min.js",
      "./holochart-3d.iife.min.js": "./dist/holochart-3d.iife.min.js",
      "./fonts/*": "./dist/fonts/*",
      "./global": {
        "types": "./global.d.ts"
      },
      "./package.json": "./package.json"
    }
  }
}
