{
  "name": "@mk7s/holochart-core",
  "version": "0.0.0",
  "description": "Figure model, attribute schema system, validation, defaults, and update planning.",
  "keywords": [
    "charts",
    "plotly",
    "data-visualization",
    "figure",
    "schema",
    "validation",
    "colorscales"
  ],
  "license": "MIT",
  "author": "sanjee",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holochart/holochart.git",
    "directory": "packages/core"
  },
  "homepage": "https://mk7s.dev/holochart",
  "bugs": {
    "url": "https://github.com/holochart/holochart/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "d3-color": "catalog:",
    "d3-format": "catalog:",
    "d3-time": "catalog:",
    "d3-time-format": "catalog:",
    "d3-array": "catalog:"
  },
  "devDependencies": {
    "@types/d3-color": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "@types/d3-format": "catalog:",
    "@types/d3-time": "catalog:",
    "@types/d3-time-format": "catalog:",
    "@types/d3-array": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "development": "./dist/index.development.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
