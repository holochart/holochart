      "editType": "calc",
      "description": "Figure layout.",
      "role": "object",
      "width": {
        "min": 10,
        "dflt": 700,
        "editType": "layout",
        "description": "Figure width in CSS pixels. Ignored when `autosize` fills the container.",
        "valType": "number"
      },
      "height": {
        "min": 10,
        "dflt": 450,
