          "noBlank": true,
          "strict": true,
          "dflt": "\"Open Sans\", verdana, arial, sans-serif",
          "description": "CSS font-family list used by every text element unless overridden.",
          "valType": "string"
        },
        "size": {
          "min": 1,
          "dflt": 12,
          "description": "Base font size in CSS pixels.",
          "valType": "number"
        },
        "color": {
          "dflt": "#444",
          "editType": "style",
          "description": "Base text color.",
          "valType": "color"
        },
        "weight": {
          "min": 1,
          "max": 1000,
          "extras": ["normal", "bold"],
          "dflt": "normal",
          "description": "Base font weight.",
          "valType": "integer"
        },
        "style": {
          "values": ["normal", "italic"],
          "dflt": "normal",
          "description": "Base font style.",
          "valType": "enumerated"
        }
      },
      "colorway": {
        "dflt": [
          "#1f77b4",
          "#ff7f0e",
          "#2ca02c",
          "#d62728",
          "#9467bd",
          "#8c564b",
          "#e377c2",
          "#7f7f7f",
          "#bcbd22",
          "#17becf"
        ],
        "editType": "style+legend",
        "description": "Default trace colors, cycled by trace index.",
        "valType": "colorlist"
      },
      "template": {
        "editType": "calc",
        "description": "Template: a registered name (`'dark'`), a `+`-composition (`'dark+presentation'`) or an object `{ layout, data }`. `null` disables the default template.",
        "valType": "any"
      },
      "title": {
        "editType": "layout+plot",
        "description": "Figure title.",
        "role": "object",
        "text": {
          "dflt": "",
          "description": "Title text (supports rich-text tags, E2.10).",
          "valType": "string"
        },
        "font": {
          "description": "Title font. Defaults to `layout.font` with 1.4× size.",
          "editType": "layout+plot",
          "role": "object",
          "family": {
            "noBlank": true,
            "strict": true,
            "description": "CSS font-family list. The renderer uses the first family it can load and falls back through the list.",
            "valType": "string"
          },
          "size": {
            "min": 1,
            "description": "Font size in CSS pixels.",
            "valType": "number"
          },
          "color": {
            "description": "Text color.",
            "editType": "style",
            "valType": "color"
          },
          "weight": {
            "min": 1,
            "max": 1000,
            "extras": ["normal", "bold"],
            "description": "Font weight: a CSS numeric weight (1–1000), `normal` or `bold`.",
            "valType": "integer"
          },
          "style": {
            "values": ["normal", "italic"],
            "description": "Font style.",
            "valType": "enumerated"
          }
        },
