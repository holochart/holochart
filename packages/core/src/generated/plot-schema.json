        "yanchor": {
          "values": ["auto", "top", "middle", "bottom"],
          "dflt": "auto",
          "description": "Vertical alignment of the title box relative to `y`.",
          "valType": "enumerated"
        }
      },
      "showlegend": {
        "editType": "legend+layout",
        "description": "Show the legend. Defaults to `true` when more than one trace has a legend entry.",
