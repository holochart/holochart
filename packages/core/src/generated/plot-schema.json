        "editType": "calc",
        "description": "Change this to force data arrays to be re-read when they are mutated in place.",
        "valType": "any"
      },
      "meta": {
        "arrayOk": true,
        "editType": "plot",
        "description": "Arbitrary user data, available in text templates as `%{meta}`.",
        "valType": "any"
      },
      "xaxis": {
        "editType": "calc",
