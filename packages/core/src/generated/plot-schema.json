      },
      "margin": {
        "editType": "layout",
        "description": "Space around the plot area.",
        "role": "object",
        "l": {
          "min": 0,
          "dflt": 80,
          "description": "Left margin in CSS pixels.",
          "valType": "number"
        },
        "r": {
          "min": 0,
          "dflt": 80,
          "description": "Right margin in CSS pixels.",
          "valType": "number"
        },
        "t": {
          "min": 0,
          "dflt": 100,
          "description": "Top margin in CSS pixels.",
          "valType": "number"
        },
        "b": {
          "min": 0,
          "dflt": 80,
          "description": "Bottom margin in CSS pixels.",
          "valType": "number"
        },
        "pad": {
          "min": 0,
          "dflt": 0,
          "description": "Padding between the plot area and the axis lines, in CSS pixels.",
          "valType": "number"
