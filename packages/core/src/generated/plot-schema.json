        "y": {
          "min": 0,
          "max": 1,
          "extras": ["auto"],
          "dflt": "auto",
          "description": "Vertical position in `yref` coordinates. `auto` places it in the top margin.",
          "valType": "number"
        },
        "xref": {
          "values": ["container", "paper"],
          "dflt": "container",
          "description": "`container` spans the whole figure; `paper` spans the plot area.",
          "valType": "enumerated"
        },
        "yref": {
          "values": ["container", "paper"],
          "dflt": "container",
          "description": "`container` spans the whole figure; `paper` spans the plot area.",
          "valType": "enumerated"
        },
        "xanchor": {
          "values": ["auto", "left", "center", "right"],
          "dflt": "auto",
          "description": "Horizontal alignment of the title box relative to `x`.",
          "valType": "enumerated"
