{
  "name": "@mk7s/holochart-traces-finance",
  "version": "0.1.0-alpha.0",
  "description": "Financial trace types: ohlc, candlestick, waterfall, funnel, funnelarea, indicator.",
  "keywords": [
    "charts",
    "plotly",
    "webgl",
    "three",
    "data-visualization",
    "financial",
    "candlestick",
    "ohlc",
    "waterfall",
    "funnel"
  ],
  "license": "MIT",
  "author": "sanjee",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holochart/holochart.git",
    "directory": "packages/traces-finance"
  },
  "homepage": "https://mk7s.dev/holochart",
  "bugs": {
    "url": "https://github.com/holochart/holochart/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
