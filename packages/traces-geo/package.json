{
  "name": "@mk7s/holochart-traces-geo",
  "version": "0.1.0-alpha.0",
  "description": "Geographic trace types on map projections: the geo subplot, scattergeo.",
  "keywords": [
    "charts",
    "plotly",
    "webgl",
    "three",
    "data-visualization",
    "maps",
    "geo",
    "projection",
    "choropleth",
    "scattergeo"
  ],
  "license": "MIT",
  "author": "sanjee",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holochart/holochart.git",
    "directory": "packages/traces-geo"
  },
  "homepage": "https://mk7s.dev/holochart",
  "bugs": {
    "url": "https://github.com/holochart/holochart/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mk7s/holochart-core": "workspace:*",
    "@mk7s/holochart-render": "workspace:*",
    "@mk7s/holochart-runtime": "workspace:*",
    "@mk7s/holochart-traces-basic": "workspace:*",
    "@types/d3-geo": "catalog:",
    "d3-geo": "catalog:",
    "d3-geo-projection": "catalog:",
    "topojson-client": "catalog:"
  },
  "peerDependencies": {
    "three": ">=0.180.0 <0.187.0"
  },
  "devDependencies": {
    "@types/geojson": "catalog:",
    "@types/three": "catalog:",
    "@types/topojson-client": "catalog:",
    "@types/topojson-specification": "catalog:",
    "three": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "development": "./dist/index.development.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
