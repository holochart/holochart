{
  "name": "holochart-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "pnpm --filter @mk7s/holochart-sandbox dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tooling": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
    "test:visual": "playwright test",
    "test:visual:update": "UPDATE_BASELINES=1 playwright test",
    "test:bundle": "turbo run build --filter=@mk7s/holochart && playwright test -c tests/bundle/playwright.config.ts",
    "test:visual:report": "node tests/visual/report.ts",
    "test:interaction": "playwright test -c tests/interaction/playwright.config.ts",
    "build:packages": "turbo run build --filter=./packages/*",
    "size": "pnpm build:packages && node tests/bundle/size/bundle.ts && size-limit",
    "size:report": "node tests/bundle/size/report.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:pack": "pnpm build:packages && changeset pack --out-dir release-artifacts",
    "release:publish": "changeset publish --from-pack-dir release-artifacts",
    "docs:publish": "node scripts/publish-docs-mk7s.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "~3.9.8",
    "turbo": "~2.11.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.5.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@changesets/cli": "^3.0.3",
    "size-limit": "^14.0.0",
    "@size-limit/file": "^14.0.0"
  }
}
